rules_version = '2';

// Split Pay security rules (phase 7). Published in the Firebase console: Firestore > Rules.
// Who can do what:
//  - Only signed-in members of a group can read or change it and its expenses.
//  - Anyone signed in may create a group with only themselves as member.
//  - Someone with the invite link may add themselves (and only themselves) to the group.
//  - Nothing is ever hard-deleted: deleting sets deleted = true.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isMember(data) { return signedIn() && request.auth.uid in data.memberUids; }

    // Online backups: each account sees only its own.
    match /users/{userId}/{document=**} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    match /groups/{groupId} {
      allow read: if isMember(resource.data);

      allow create: if signedIn()
        && request.resource.data.memberUids == [request.auth.uid]
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.inviteCode is string
        && request.resource.data.inviteCode.size() >= 8;

      // Members edit the group, but cannot add or remove other accounts, or change the owner.
      allow update: if isMember(resource.data)
        && request.resource.data.memberUids == resource.data.memberUids
        && request.resource.data.ownerUid == resource.data.ownerUid;

      // Joining with the invite link: add only yourself, and prove you have the code.
      allow update: if signedIn()
        && !(request.auth.uid in resource.data.memberUids)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids', 'lastJoinCode'])
        && request.resource.data.lastJoinCode == resource.data.inviteCode
        && request.resource.data.memberUids.toSet().difference(resource.data.memberUids.toSet()) == [request.auth.uid].toSet()
        && resource.data.memberUids.toSet().difference(request.resource.data.memberUids.toSet()).size() == 0;

      allow delete: if false;

      match /items/{itemId} {
        allow read, create, update: if isMember(get(/databases/$(database)/documents/groups/$(groupId)).data);
        allow delete: if false;
      }

      // Receipt photos: small JPEGs, members only.
      match /photos/{photoId} {
        allow read: if isMember(get(/databases/$(database)/documents/groups/$(groupId)).data);
        allow create, update: if isMember(get(/databases/$(database)/documents/groups/$(groupId)).data)
          && request.resource.data.data is string
          && request.resource.data.data.size() < 900000;
        allow delete: if false;
      }
    }
  }
}
